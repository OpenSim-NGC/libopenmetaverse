<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectType>Local</ProjectType>
    <OutputType>Library</OutputType>
    <AssemblyName>OpenMetaverse</AssemblyName>
    <PackageId>UtopiaSkye.OpenMetaverse</PackageId>
    <Description>Client library for the NGC OpenMetaverse-compatible Tranquillity virtual world servers. Provides login, inventory, asset, object, and messaging APIs.</Description>
    <Authors>OpenSim NGC</Authors>
    <Company>Utopia Skye LLC</Company>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="CoreJ2K" Version="2.4.1.108" />
    <PackageReference Include="CoreJ2K.Skia" Version="2.4.1.108" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="XMLRPC">
      <HintPath>..\AppData\XMLRPC.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenMetaverse.StructuredData\OpenMetaverse.StructuredData.csproj" />
    <ProjectReference Include="..\OpenMetaverse.Types\OpenMetaverse.Types.csproj" />
  </ItemGroup>
</Project>
