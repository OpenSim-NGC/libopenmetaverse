<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectType>Local</ProjectType>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenMetaverse</RootNamespace>  
    <AssemblyName>OpenMetaverse.Types</AssemblyName>
    <PackageId>UtopiaSkye.OpenMetaverse.Types</PackageId>
    <Description>Core value types for the OpenMetaverse library: UUID, Vector2/3/4, Quaternion, Matrix4, Color4, and related utilities.</Description>
    <Authors>OpenSim NGC</Authors>
    <Company>Utopia Skye LLC</Company>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>
